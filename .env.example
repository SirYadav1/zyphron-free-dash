# ============================================
# Zyphron Free Dashboard — Environment Config
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# Database
DB_TYPE=sqlite
DB_DATABASE=zyphron.db

# Pterodactyl Panel
PTERODACTYL_PANEL_URL=https://your-panel-url.com/
PTERODACTYL_API_KEY=ptla_your-api-key-here

# Mail Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=noreply@your-domain.com

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_CALLBACK_URL=http://localhost:3000/api/discord/callback
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-guild-id

# Admin Setup Key (for first admin registration)
ADMIN_KEY=your-secure-admin-setup-key-change-this

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173
